
{
  "version": 2,
  "builds": [
{ "src": "api/index.js", "use": "@vercel/node" },
{ "src": "api/config.js", "use": "@vercel/node" }
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/generate", "dest": "/api/index.js" },
    { "src": "/api/config", "dest": "/api/config.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}

